      data.forEach(vote=>{
        const tr=document.createElement("tr");
        [vote.nickname,pollNames[vote.poll_id]||vote.poll_id,vote.choice,new Date(vote.created_at).toLocaleString("es-MX")].forEach(value=>{
          const td=document.createElement("td");td.textContent=value;tr.appendChild(td);
        });
        tbody.appendChild(tr);
      });
      document.getElementById("adminSummary").innerHTML="";
      const summary=document.getElementById("adminSummary");
      const total=document.createElement("div");total.className="admin-stat";total.textContent="VOTOS REGISTRADOS";
      const totalStrong=document.createElement("strong");totalStrong.textContent=String(data.length);total.appendChild(totalStrong);summary.appendChild(total);
      const people=document.createElement("div");people.className="admin-stat";people.textContent="APODOS PARTICIPANTES";
      const peopleStrong=document.createElement("strong");peopleStrong.textContent=String(new Set(data.map(v=>v.nickname.toLowerCase())).size);people.appendChild(peopleStrong);summary.appendChild(people);
      adminStatus.textContent=data.length?"Estos son los votos guardados (máximo 500 registros por consulta).":"Todavía no hay votos registrados.";
    }

    document.getElementById("adminSignIn").addEventListener("click",async()=>{
      if(!db){adminStatus.textContent="Configura primero Supabase en el código.";return;}
      const email=document.getElementById("adminEmail").value.trim();
      const password=document.getElementById("adminPassword").value;
      adminStatus.textContent="Verificando acceso…";
      const {error}=await db.auth.signInWithPassword({email,password});
      if(error){adminStatus.textContent="No se pudo iniciar sesión. Revisa tus datos de acceso.";return;}
      adminLogin.hidden=true;adminDashboard.hidden=false;await loadAdminVotes();
    });
    document.getElementById("refreshVotes").addEventListener("click",loadAdminVotes);
    document.getElementById("adminSignOut").addEventListener("click",async()=>{
      if(db) await db.auth.signOut();
      adminLogin.hidden=false;adminDashboard.hidden=true;adminStatus.textContent="Sesión cerrada.";
    });
    if(db){
      db.auth.getSession().then(({data})=>{
        if(data.session){adminLogin.hidden=true;adminDashboard.hidden=false;loadAdminVotes();}
      });
    }
  </script>
</body>
</html>
