/* Pink section polish: pastel light blooms and delicate texture, no dark-to-pink fade */
.private-life{
  position:relative;
  isolation:isolate;
  background-color:#fff0f6 !important;
  background-image:
    radial-gradient(ellipse at 8% 12%, rgba(255,255,255,.96) 0%, rgba(255,255,255,0) 34%),
